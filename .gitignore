# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Match data (generated at runtime)
matches/*/
matches/*.log
matches/*_summary.json
matches/*.tar.gz
matches_logs/
traces/
*.log

# Temporary scenario scratch
**/__tmp*/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Environment (API keys)
.env

# Local secrets (GCS service-account key, etc.) — never commit
.secrets/
*-sa.json
*.serviceaccount.json

# Claude Code local state
.claude/scheduled_tasks.lock
.claude/*.lock
